# Copy this file to .env and fill in your values
# NEVER commit .env to git

# Gmail that SENDS the digest (needs an App Password, not your real password)
SENDER_EMAIL=your_sender@gmail.com
SENDER_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Emails that RECEIVE the digest (comma-separated for multiple)
RECIPIENT_EMAILS=recipient1@gmail.com,recipient2@gmail.com

# ── WhatsApp Bot Configurations ──────────────────────────────────────
TARGET_PHONE=+919876543210
SCRAPE_TARGET_URL=https://news.google.com
TARGET_KEYWORDS=register now,apply,apply now,register,sign up

# Option A: Twilio Credentials (Official & Free Sandbox)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Option B: UltraMsg Credentials (Unofficial Personal API, ~$10/mo)
ULTRAMSG_INSTANCE_ID=
ULTRAMSG_TOKEN=

